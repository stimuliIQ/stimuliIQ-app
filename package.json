{
  "name": "stimuliiq",
  "version": "0.0.0",
  "private": true,
  "description": "stimuliiq — EdTech ecosystem monorepo (web + lms + crm + api)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "e2e": "turbo run e2e",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "gen:keys": "node ./infra/scripts/gen-keys.mjs",
    "db:migrate": "turbo run db:migrate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "ts-node --project prisma/tsconfig.seed.json prisma/seed.ts",
    "db:seed:medical": "ts-node --project prisma/tsconfig.seed.json prisma/seed-medical.ts",
    "db:seed:neurology": "ts-node --project prisma/tsconfig.seed.json prisma/seed-neurology-curriculum.ts",
    "db:seed:psychology": "ts-node --project prisma/tsconfig.seed.json prisma/seed-psychology-curriculum.ts",
    "db:seed:onboarding": "ts-node --project prisma/tsconfig.seed.json prisma/seed-onboarding.ts",
    "db:seed:leave": "ts-node --project prisma/tsconfig.seed.json prisma/seed-leave.ts",
    "db:seed:careers": "ts-node --project prisma/tsconfig.seed.json prisma/seed-careers.ts",
    "db:seed:twofa-reset": "ts-node --project prisma/tsconfig.seed.json prisma/seed-two-factor-reset.ts",
    "db:seed:audit-permissions": "ts-node --project prisma/tsconfig.seed.json prisma/seed-audit-permissions.ts",
    "db:seed:user-delete": "ts-node --project prisma/tsconfig.seed.json prisma/seed-user-delete.ts",
    "db:seed:user-reset-password": "ts-node --project prisma/tsconfig.seed.json prisma/seed-user-reset-password.ts",
    "db:seed:attempts-grade": "ts-node --project prisma/tsconfig.seed.json prisma/seed-attempts-grade.ts",
    "db:seed:lead-performance": "ts-node --project prisma/tsconfig.seed.json prisma/seed-lead-performance.ts",
    "db:seed:course-types": "ts-node --project prisma/tsconfig.seed.json prisma/seed-course-types.ts",
    "db:seed:marketing-targets": "ts-node --project prisma/tsconfig.seed.json prisma/seed-marketing-targets.ts",
    "db:seed:org": "ts-node --project prisma/tsconfig.seed.json prisma/seed-org.ts",
    "db:seed:org-permissions": "ts-node --project prisma/tsconfig.seed.json prisma/seed-org-permissions.ts",
    "dev:provision:e2e-org": "node scripts/dev-provision-e2e-org.cjs",
    "resync:progress": "ts-node --project prisma/tsconfig.seed.json prisma/resync-enrollment-progress.ts",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "prepare": "node ./infra/scripts/check-env-example.mjs || true",
    "db:seed:certificate-templates": "ts-node --project prisma/tsconfig.seed.json prisma/seed-certificate-templates.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.2.0",
      "ioredis": "^5.11.1",
      "isomorphic-dompurify>jsdom": "25.0.1"
    }
  }
}
