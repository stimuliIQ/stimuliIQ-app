{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "target": "ES2022",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  "ts-node": {
    "transpileOnly": true
  },
  "include": ["seed.ts"]
}
