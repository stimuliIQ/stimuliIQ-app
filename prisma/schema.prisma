  branch
  assigned
  own
}

enum ProgramMode {
  live
  recorded
  hybrid
}

enum ProgramStatus {
  draft
  published
  archived
}

enum LessonType {
  video
  reading
  assignment
  quiz
}

enum StudentCourseType {
