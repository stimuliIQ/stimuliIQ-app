  @@index([tenantId, status, publishedAt])
  @@index([categoryId])
  @@index([tenantId, deletedAt])
  @@map("blog_posts")
}

// Testimonial.studentName is intentionally UNMASKED in audit snapshots (no
// PII_FIELD_REGISTRY entry) — a testimonial is explicitly consented public-facing
// marketing content (the whole point is the name is displayed publicly), unlike
// Lead.name/Mentor.fullName which are internal records about a person who has not
// necessarily consented to public display. Same posture as FacultyBio.name below.
model Testimonial {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  programId       String?       @map("program_id") @db.Uuid
  studentName     String        @map("student_name")
  studentPhotoKey String?       @map("student_photo_key")
  quote           String
  // rating: 0-50 = 0.0-5.0 stars ×10 scale (no floats — same convention as
  // Program.ratingAvg). Nullable — a testimonial need not carry a star rating.
  rating          Int?
  status          ContentStatus @default(draft)
  order           Int           @default(0)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  program Program? @relation(fields: [programId], references: [id])

  @@index([tenantId, status])
  @@index([programId])
  @@index([tenantId, deletedAt])
  @@map("testimonials")
}

model Partner {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  name      String
  logoKey   String?       @map("logo_key")
  url       String?
  // category: open-ended string (e.g. "hiring_partner", "tech_partner") — matches the
  // Resource.type / CertificateTemplate.status "no enum for an open editor-driven set"
  // precedent.
  category    String?
  // focus/established/city — ADDITIVE, nullable (Phase-10 page-builder spec,
  // docs/specs/phase-10-page-builder.md): back the homepage "partner colleges" reference
  // block (apps/web/src/components/home/partner-colleges.tsx), which today hardcodes a
  // one-line focus blurb, founding year, and city per partner alongside the existing
  // name/logo/url/category fields. `established` is a bare year (Int, e.g. 1963) — every
  // hardcoded value is a plain 4-digit year, no free-text "circa"/"est. 1900s" values
  // exist today, so Int is a precise fit (not a floats-in-money concern; this is a
  // calendar year, not currency). All three nullable — existing non-college partners
  // (hiring/tech partners) legitimately have none of the three.
  focus       String?
  established Int?
  city        String?
  status    ContentStatus @default(draft)
  order     Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  deletedAt DateTime?     @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("partners")
}

// FacultyBio — the PUBLIC marketing bio shown on the website, distinct from
// `faculty_profiles` (the internal HR/LMS-assignment record). `facultyProfileId` is
// nullable because a public bio may exist for a guest lecturer / mentor with no
// internal FacultyProfile row. FacultyBio.name is intentionally unmasked in audit
