// ── Phase-2 enums (docs/plans/phase-2.md task #1) ────────────────────────────

enum OrderStatus {
  created
  paid
  failed
  refunded
}

enum PaymentStatus {
  created
  authorized
  captured
  failed
  refunded
}

// docs/05 §3 table says "pending|generated|failed"; task spec says "draft|issued|void".
