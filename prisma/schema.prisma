model FacultyBio {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  facultyProfileId String?       @map("faculty_profile_id") @db.Uuid
  name             String
  photoKey         String?       @map("photo_key")
  title            String?
  bio              String
  socialLinks      Json?         @map("social_links")
  status           ContentStatus @default(draft)
  order            Int           @default(0)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  facultyProfile FacultyProfile? @relation(fields: [facultyProfileId], references: [id])

  @@index([tenantId, status])
  @@index([facultyProfileId])
  @@index([tenantId, deletedAt])
  @@map("faculty_bios")
}

// ContentPage — generic block-based CMS page (docs/plans/phase-9-completion.md T8's
// "ContentBlock/Page" option). `body` is a JSON array of typed content blocks
// (e.g. [{type:"hero", data:{...}}, {type:"richtext", data:{html:"..."}}]) rendered
// through the DOMPurify sink (@repo/ui rich-text/MDX render sink, T19).
model ContentPage {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  slug           String
  title          String
  body           Json
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  // seoImagePath — Phase-11 locked templates (docs/plans/phase-11-locked-templates.md
  // "SEO: ... add a new per-page OG image"). Prisma field name matches the DTO 1:1
  // (`seoImagePath`, packages/types/src/content/pages.schemas.ts) rather than the sitewide
  // `*ImageKey` convention (Program.ogImageKey, BlogPost.coverImageKey) — a deliberate,
  // documented exception: the DTO layer had already named this field `seoImagePath`
  // (Phase-11 P1, matching `SiteSetting`'s existing `defaultOgImagePath` JSON-field
  // precedent for the sitewide OG-image fallback), so keeping the Prisma field name
  // identical avoids a silent rename/translation at every repository/service call site.
  // Value is still a StorageProvider object key (ObjectKeySchema), never a raw URL —
  // same "stored key, CDN URL minted at serve time" contract as every `*ImageKey` field.
  // Nullable/additive: every existing row is unaffected (null until a super_admin sets one).
  seoImagePath   String?       @map("seo_image_path")
  status         ContentStatus @default(draft)
  publishedAt    DateTime?     @map("published_at")
  // isBuilderManaged — Phase-10 page-builder spec (docs/specs/phase-10-page-builder.md):
  // pages authored through the CRM block-based page builder are "save-is-live" (every
  // save publishes immediately), which is a DIFFERENT lifecycle from the generic CMS
  // draft->publish workflow every other ContentPage row still uses. This is a queryable
  // structural flag, not a business rule buried in service code, because it drives real
  // schema-adjacent decisions: which permission gates a write (`content.builder` vs
  // `content.edit`/`content.publish`), which CRM editor UI a row opens in, and (future)
  // which rows a DB check could constrain to `status = 'published'` always. Chose this
  // over "the builder service simply always writes status='published', no schema change"
  // because that alternative makes a page's authoring lineage unrecoverable from the DB
  // alone — a `published` row would be indistinguishable from an ordinary CMS page that
  // happened to reach `published` the normal way, which breaks "show only builder pages
  // in the builder's page list" and "route an edit request to the right permission check"
  // without an unreliable heuristic (e.g. sniffing `body`'s block shape). Defaults
  // `false` — every existing content_pages row (T8) is unaffected; no-op migration.
  isBuilderManaged Boolean @default(false) @map("is_builder_managed")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  versions ContentPageVersion[]

  @@index([slug])
  @@index([tenantId, status])
  @@index([tenantId, isBuilderManaged])
  @@index([tenantId, deletedAt])
  @@map("content_pages")
}

// ContentPageVersion — immutable snapshot history for ContentPage (CRM block-based page
// builder, super_admin-only, docs/adr/0059). Every save of a ContentPage writes a new
// version row here (title/body/seo* as they existed at save time) so the CRM can render
// a history list and support "revert to version N" without losing prior states. `version`
// is monotonic PER PAGE (1, 2, 3, ...), assigned by the service layer (no DB sequence/
// trigger — same "app-assigned monotonic counter" pattern as Submission.attemptNo /
// EmiInstallment.installmentNo elsewhere in this schema). `createdById` is REQUIRED (unlike
// BlogPost.authorId, which is nullable) — a version snapshot only ever exists because an
// authenticated CRM actor triggered a save; there is no "authorless" version.
model ContentPageVersion {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  contentPageId  String    @map("content_page_id") @db.Uuid
  version        Int
  title          String
  body           Json
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description")
  // seoImagePath — same field/mapping decision as ContentPage.seoImagePath above; every
  // save/revert snapshots the page's seoImagePath at that point in time alongside
  // title/body/seoTitle/seoDescription (Phase-11 locked templates).
  seoImagePath   String?   @map("seo_image_path")
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  contentPage ContentPage @relation(fields: [contentPageId], references: [id])
  createdBy   User        @relation(fields: [createdById], references: [id])

  // (contentPageId, version) is a HARD @@unique (not a raw-SQL partial-unique like the
  // slug/key tables) — version snapshots are append-only history; there is no
  // "reissue after soft-delete" scenario that would need the uniqueness to free up. The
  // `sort: Desc` modifier makes this same index directly usable for the CRM history-list
  // query (`ORDER BY version DESC WHERE content_page_id = ?`), so a separate desc index
  // is not needed on top of it.
  @@unique([contentPageId, version(sort: Desc)])
  @@index([contentPageId, createdAt])
  @@index([tenantId, deletedAt])
  @@map("content_page_versions")
}

// NewsletterSubscription — footer newsletter opt-in (docs/plans/phase-9-completion.md
// T32). email is per-tenant partial-unique (WHERE deleted_at IS NULL — raw SQL) so a
// re-subscribe after unsubscribe (soft-delete) is allowed.
model NewsletterSubscription {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  email          String
  // consent: DPDP consent capture — SAME shape as Lead.consent (docs/plans/phase-5.md §2).
  consent        Json?
  status         String    @default("active")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("newsletter_subscriptions")
}

// ContactSubmission — the public "Contact Us" form (docs/plans/phase-9-completion.md T32).
model ContactSubmission {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String    @default("new")
  consent   Json?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("contact_submissions")
}

// CareerApplication — public "Careers" apply form (docs/plans/phase-9-completion.md T32).
// resumeStorageKey: S3/R2 object key — NOT a raw URL (docs/05 §7); signed download URL
// minted on demand for HR/admin readers.
model CareerApplication {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  name             String
  email            String
  phone            String?
  role             String
  resumeStorageKey String    @map("resume_storage_key")
  coverLetter      String?   @map("cover_letter")
  status           String    @default("new")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("career_applications")
}

// ── T9: FeatureFlag + Setting (system/company scope) ────────────────────────────────

model FeatureFlag {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  key         String
  enabled     Boolean   @default(false)
  // rollout: optional rule descriptor (e.g. {percentage: 25} or {cohort: ["beta"]}) for
  // gradual/targeted rollout beyond a flat on/off.
  rollout     Json?
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, enabled])
  @@index([tenantId, deletedAt])
  @@map("feature_flags")
}

model Setting {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  scope     SettingScope @default(company)
  key       String
  value     Json
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, scope])
  @@index([tenantId, deletedAt])
  @@map("settings")
}

// SiteSetting — sitewide marketing-website primitives editable from the CRM page builder
// (super_admin only): nav labels, footer columns, SEO defaults, contact details, WhatsApp
// number, homepage headline stat numbers. `key` is a dotted namespace, e.g.
// "nav.primary_links", "footer.columns", "seo.defaults", "contact.details",
// "contact.whatsapp", "stats.headline". `group` mirrors the key's leading namespace
// segment as a plain open-ended string ('nav'|'footer'|'seo'|'contact'|'stats' today) —
// same "open editor-driven set, no enum migration per new group" precedent as
// `Partner.category`/`Resource.type` — purely for CRM UI tab/section grouping, not
// queried as a uniqueness dimension.
//
// DELIBERATELY NOT reusing the existing `Setting` model (tenantId+scope+key, scope =
// system|company) even though it is structurally almost identical (keyed Json value,
// same partial-unique-after-soft-delete pattern). Reusing it would put SiteSetting rows
// behind the EXISTING `settings.view`/`settings.edit` permissions, which are already
// granted more broadly than this feature allows (`branch_manager` holds `settings.view`
// at scope=branch — prisma/seed.ts:3706 — and the generic `GET /settings` CRM screen
// would then surface nav/footer/SEO copy to roles this feature must keep OUT). A
// dedicated model + dedicated `site_settings.view`/`site_settings.edit` permissions
// (super_admin-only, see prisma/seed.ts) keeps the RBAC boundary real instead of relying
// on a future service-layer filter to hide rows the generic settings screen technically
// has permission to return. See this migration's report for the full reuse-vs-new-model
// evaluation (db-architect).
model SiteSetting {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  key       String
  group     String
  value     Json
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // (tenantId, key) uniqueness is a raw-SQL partial-unique index
  // (`site_settings_active_tenant_key_key`, WHERE deleted_at IS NULL) — same pattern as
  // feature_flags/settings/kb_articles etc. (docs/05 §4); not expressible in `@@unique`.
  @@index([tenantId, group])
  @@index([tenantId, deletedAt])
  @@map("site_settings")
}

// ── T10: Bookmark (polymorphic ref_type/ref_id) + LessonNote ────────────────────────

// Bookmark — polymorphic: refType is an open-ended string (e.g. "lesson",
// "video_timestamp", "blog_post"), matching the Resource.type / ExportJob.type "open
// editor/event-driven set, no enum migration per new type" precedent. timestampS is
// set for video-timestamp bookmarks (nullable — irrelevant for non-video ref types).
model Bookmark {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  refType    String    @map("ref_type")
  refId      String    @map("ref_id") @db.Uuid
  note       String?
  timestampS Int?      @map("timestamp_s")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, userId])
  @@index([userId, refType])
  @@index([tenantId, deletedAt])
  @@map("bookmarks")
}

// LessonNote — a student's personal note on a lesson, optionally anchored to a video
// timestamp. Multiple notes per (user, lesson) are allowed (no uniqueness constraint —
// a student may leave several timestamped notes across one lesson's video).
model LessonNote {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  lessonId   String    @map("lesson_id") @db.Uuid
  timestampS Int?      @map("timestamp_s")
  body       String
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@index([tenantId, userId, lessonId])
  @@index([lessonId])
  @@index([tenantId, deletedAt])
  @@map("lesson_notes")
}

// ── T11: Referral/affiliate + EmiPlan + EmiInstallment (dunning) ────────────────────

// Referral — an affiliate/referral link + its attribution outcome. `code` is an
// EXTENSION vs. docs/05 §3's spec (`referrer_user_id, referred_lead_id, reward,
// status` only) — a trackable referral link needs a stable code; docs-writer should
// add `code` to docs/05 §3 "referrals" row.
model Referral {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  referrerUserId String         @map("referrer_user_id") @db.Uuid
  referredLeadId String?        @map("referred_lead_id") @db.Uuid
  code           String
  // reward: JSON descriptor, e.g. {"type":"cash","amountPaise":50000,"currency":"INR"}
  // or {"type":"discount_coupon","couponId":"..."}. Money-in-paise rule (CLAUDE.md
  // §3.6) applies to any amountPaise key inside this JSON.
  reward         Json?
  status         ReferralStatus @default(pending)
  rewardedAt     DateTime?      @map("rewarded_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  tenant       Tenant @relation(fields: [tenantId], references: [id])
  referrer     User   @relation("ReferralReferrer", fields: [referrerUserId], references: [id])
  referredLead Lead?  @relation(fields: [referredLeadId], references: [id])

  @@index([tenantId, referrerUserId])
  @@index([referredLeadId])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("referrals")
}

// EmiPlan — an installment payment plan against one Order. Partial-unique
// `(order_id) WHERE deleted_at IS NULL` (raw SQL) allows re-planning after a
// cancelled plan is soft-deleted (same "reissue" pattern as Certificate.enrollmentId).
model EmiPlan {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  orderId          String        @map("order_id") @db.Uuid
  totalAmountPaise Int           @map("total_amount_paise")
  currency         String        @default("INR")
  numInstallments  Int           @map("num_installments")
  startDate        DateTime      @map("start_date")
  status           EmiPlanStatus @default(active)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  order        Order            @relation(fields: [orderId], references: [id])
  installments EmiInstallment[]

  @@index([tenantId, status])
  @@index([orderId])
  @@index([tenantId, deletedAt])
  @@map("emi_plans")
}

// EmiInstallment — one scheduled installment of an EmiPlan. Partial-unique
// `(emi_plan_id, installment_no) WHERE deleted_at IS NULL` (raw SQL) enforces one
// active row per installment ordinal. `paymentId` links to the Payment row that
// settled this installment (set once captured); `dunningAttempts`/`lastDunningAt`
// drive the BullMQ dunning-reminder schedule (T18/T24).
model EmiInstallment {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  emiPlanId       String               @map("emi_plan_id") @db.Uuid
  installmentNo   Int                  @map("installment_no")
  amountPaise     Int                  @map("amount_paise")
  dueDate         DateTime             @map("due_date")
  status          EmiInstallmentStatus @default(pending)
  paidAt          DateTime?            @map("paid_at")
  paymentId       String?              @map("payment_id") @db.Uuid
  dunningAttempts Int                  @default(0) @map("dunning_attempts")
  lastDunningAt   DateTime?            @map("last_dunning_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  emiPlan EmiPlan  @relation(fields: [emiPlanId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([tenantId, status, dueDate])
  @@index([emiPlanId])
  @@index([tenantId, deletedAt])
  @@map("emi_installments")
}

// ── T12: LandingPage (campaign, A/B variant) + LeadForm (field config) ──────────────

// LandingPage — a campaign-specific marketing page, optionally A/B tested via
// `variant`. Partial-unique `(tenant_id, slug, variant) WHERE deleted_at IS NULL`
// (raw SQL) — the same slug may have multiple variants ("a", "b", ...) live
// simultaneously for split-testing, but only one active row per (slug, variant).
model LandingPage {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  campaign       String?
  slug           String
  title          String
  variant        String        @default("a")
  content        Json
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  status         ContentStatus @default(draft)
  publishedAt    DateTime?     @map("published_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([slug])
  @@index([tenantId, campaign])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("landing_pages")
}

// LeadForm — a configurable lead-capture form definition (embedded on web pages).
// `key` is the stable identifier embedding code references (e.g. "homepage-hero",
// "program-detail-sticky"). Partial-unique `(tenant_id, key) WHERE deleted_at IS
// NULL` (raw SQL). `fields` is a JSON array of field descriptors:
// [{key, label, type, required}].
model LeadForm {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  key             String
  name            String
  fields          Json
  targetProgramId String?   @map("target_program_id") @db.Uuid
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  targetProgram Program? @relation(fields: [targetProgramId], references: [id])

  @@index([tenantId, active])
  @@index([tenantId, deletedAt])
  @@map("lead_forms")
}
