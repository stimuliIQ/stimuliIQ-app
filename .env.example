# stimuliiq — environment variables (Phase 0)
#
# Copy this file to `.env` at the repo root: `cp .env.example .env`
# Validated at boot by apps/api/src/config/env.ts (zod, fails fast on missing/invalid
# REQUIRED vars). Never commit `.env` or any real secret (CLAUDE.md §3.12).

# ──────────────────────────────────────────────────────────────────────────────
# APP
# ──────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=local
API_PORT=4000

# App URLs (used for CORS allow-list across web/lms/crm — docs/04 §4)
WEB_APP_URL=http://localhost:3000
LMS_APP_URL=http://localhost:3001
CRM_APP_URL=http://localhost:3002

# ──────────────────────────────────────────────────────────────────────────────
# FRONTEND API BASE URLS (Wave 5 — frontend-builder)
# Public (inlined into the client bundle, never put secrets here): each app's
# @repo/api-client instance reads this at bootstrap as the `baseUrl`. Must
# point at the api's versioned root WITHOUT a trailing slash; the SDK appends
# paths like `/api/v1/me` itself. Next.js apps use NEXT_PUBLIC_*; the Vite SPA
# uses VITE_*. All three point at the same local API in dev.
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000

# Origin of the PUBLIC marketing site (apps/web). The CRM links OUT to it for the
# unauthenticated certificate verification page (/verify/<certUid>), the Page Builder's
# "View live page" toast link + list "Web address" column, and to resolve page-builder
# `/images/...` static-asset preview thumbnails — those pages/files are served by `web`,
# not by the CRM, so a relative link would 404 on :3002.
VITE_WEB_APP_URL=http://localhost:3000

# CDN base the CRM Page Builder mints storage-object-key image fields against for preview
# thumbnails (docs/specs/phase-10-ui-polish-visual-audit.md PB-4). Mirrors the API's own
# PUBLIC_ASSET_BASE_URL default — keep in sync so a key previews at the same place it will
# actually render on the public site.
VITE_ASSET_BASE_URL=https://cdn.stimuliiq.com

# ──────────────────────────────────────────────────────────────────────────────
# WEB APP PUBLIC CONFIG (apps/web — Phase 5, Task #6 / Task #11)
#
# CLASSIFICATION LEGEND
# [PUBLIC-CLIENT]  — NEXT_PUBLIC_* prefix; bundled into the browser. Safe to expose.
#                    Set in Vercel project env → "Environment Variables" → no "Secret".
# [SERVER-ONLY]    — No NEXT_PUBLIC_* prefix; never reaches the browser bundle.
#                    Set in Vercel project env → "Environment Variables" → mark Secret.
#                    NEVER put these in a NEXT_PUBLIC_* var or a client component.
#
# All vars in this section are [PUBLIC-CLIENT] unless explicitly marked [SERVER-ONLY].
# ──────────────────────────────────────────────────────────────────────────────

# [PUBLIC-CLIENT] Canonical site URL — used for sitemap, OG metadata, JSON-LD canonical URLs.
# Set to the actual production URL in staging/prod environments.
# Must NOT have a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [PUBLIC-CLIENT] WhatsApp click-to-chat deep link (docs/01 §7.7).
# NEXT_PUBLIC_WHATSAPP_NUMBER: digits only, include country code (e.g. 919999999999 for +91).
# NEXT_PUBLIC_WHATSAPP_MESSAGE: URL-encoded prefilled message (optional).
# The site assembles: https://wa.me/{NUMBER}?text={MESSAGE}
# NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
# NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi%2C%20I%20want%20to%20know%20more%20about%20StimuliiQ%20programs

# TOS version — pinned in consent records on all public form submissions (DPDP).
# Change this string when the Terms of Service are updated.
# All future form submissions record the new version; provides proof of consent version.
TOS_VERSION=v1.0

# ── Razorpay — classification note (Phase 5, Task #11) ───────────────────────
# RAZORPAY_KEY_ID      — [SERVER-ONLY] used by the NestJS API PaymentProvider.
#                        The PUBLIC Razorpay key that the browser checkout receives is
#                        returned by the API response (POST /public/enroll/checkout →
#                        { razorpayOrderId, publicKeyId }). It is NOT set as a
#                        NEXT_PUBLIC_* env var — it comes from the API at runtime.
# RAZORPAY_KEY_SECRET  — [SERVER-ONLY] NEVER set as NEXT_PUBLIC_*. NestJS only.
# RAZORPAY_WEBHOOK_SECRET — [SERVER-ONLY] NEVER set as NEXT_PUBLIC_*. NestJS only.
# (Keys already documented below in the payments section — this note is the
#  classification reminder so it cannot be mis-wired during Vercel provisioning.)

# ──────────────────────────────────────────────────────────────────────────────
# DATABASE (Postgres 16 via Prisma — must match infra/docker-compose.yml)
# ──────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stimuliiq
POSTGRES_PORT=5432
# Connection string consumed by Prisma. PK convention is uuid v4 (docs/05 §1).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stimuliiq

# ──────────────────────────────────────────────────────────────────────────────
# REDIS (cache + sessions + BullMQ — must match infra/docker-compose.yml)
# ──────────────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────────────────────────────────────
# JWT (RS256 access 15m + rotating refresh 7d — CLAUDE.md §1)
# ──────────────────────────────────────────────────────────────────────────────
# Generate a LOCAL-ONLY dev keypair with: `pnpm gen:keys` (writes into gitignored keys/).
# Real staging/prod keys come from a secrets manager — never commit PEM files.
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Audience claim embedded in every signed access/refresh token and REQUIRED on verify
# (Phase-7 Wave 2 security hardening — closes P0 followups M-4). Optional: defaults to
# "stimuliiq-clients" in code. Override once a second consumer of these tokens exists.
JWT_AUDIENCE=stimuliiq-clients

# ──────────────────────────────────────────────────────────────────────────────
# IP-DIMENSION RATE LIMITING (Phase-7 Wave 2 security hardening — closes P0 M-6)
# ──────────────────────────────────────────────────────────────────────────────
# Auth routes (POST /auth/login, /auth/otp/request, /auth/otp/verify, /auth/refresh) —
# FAIL CLOSED on a Redis error (see modules/auth/guards/auth-ip-rate-limit.guard.ts).
AUTH_IP_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_IP_RATE_LIMIT_MAX_ATTEMPTS=20
# Webhook routes (payment + campaign delivery webhooks) — FAIL OPEN on a Redis error;
# HMAC signature verification is the primary control (see
# common/rate-limit/webhook-ip-rate-limit.guard.ts).
WEBHOOK_IP_RATE_LIMIT_WINDOW_SECONDS=60
WEBHOOK_IP_RATE_LIMIT_MAX_ATTEMPTS=300

# Webhook signature-timestamp freshness window, in seconds (closes part of P6 M-3).
# A validly-signed webhook payload older than this is rejected (anti-replay).
WEBHOOK_SIGNATURE_MAX_AGE_SECONDS=300

# ──────────────────────────────────────────────────────────────────────────────
# COOKIES / CSRF (auth uses httpOnly cookies + CSRF — locked decision)
# ──────────────────────────────────────────────────────────────────────────────
# COOKIE_SECRET / CSRF_SECRET must each be >= 32 chars. Generate with e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace-with-a-random-32-plus-char-secret-before-running-locally
CSRF_SECRET=replace-with-a-different-random-32-plus-char-secret-here
COOKIE_DOMAIN=localhost
# Set to "true" behind HTTPS (staging/prod). Must be "false" for local http://localhost.
COOKIE_SECURE=false

# ════════════════════════════════════════════════════════════════════════════
# DEFERRED PROVIDER KEYS — optional / stubbed in Phase 0
# Features behind these env vars no-op cleanly when the var is absent.
# Wire real values when the corresponding phase/wave lands (see docs/plans/phase-0.md
# "Secrets the user must supply" + CLAUDE.md §1 provider interfaces).
# ════════════════════════════════════════════════════════════════════════════

# --- Observability (Sentry SaaS + hosted OTel collector) — Phase 7 WS-C ---
# ALL optional — fully no-op (and boot-safe) with none of these set; activate ONLY in
# staging/prod by supplying real values (see apps/api/src/observability/sentry.ts and
# otel.ts). Never set SENTRY_DSN/OTEL_EXPORTER_OTLP_ENDPOINT in a local/test .env.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging
# OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=stimuliiq-api

# --- Scheduler (cron) — Phase 7 Wave 2 task #11 ---
# Gates registration of every P7 cron job (MV-refresh + report-schedule dispatch).
# Left unset: disabled automatically when NODE_ENV=test (Jest), enabled otherwise.
# Set explicitly to force one way or the other. See apps/api/src/config/scheduler.ts.
# SCHEDULER_ENABLED=true
ANALYTICS_MV_REFRESH_INTERVAL_MS=300000
REPORT_SCHEDULE_DISPATCH_INTERVAL_MS=60000

# --- Campaign send batch cap (docs/plans/phase-9-completion.md T5 / R2) ---
# Bounds a single POST /campaigns/:id/send request to at most this many recipients
# (sync-seam send loop). Remainder stays queued for a follow-up call. Default: 500.
CAMPAIGN_SEND_BATCH_SIZE=500

# --- Metrics scrape endpoint (GET /metrics) — Phase 7 WS-C ---
# Static bearer token for the Prometheus scrape endpoint (X-Metrics-Token header).
# Optional in dev/test (endpoint stays open); REQUIRED in staging/production (the
# endpoint 403s/is unreachable without it — fail-closed, never publicly enumerable by
# accident). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# METRICS_TOKEN=

# --- SMS / OTP (MSG91) — behind SmsProvider (Phase 9 T16 / B3) ---
#
# SMS_PROVIDER selects the adapter at boot. Default: "noop" (no SMS sent, OTP never
# logged, dev + CI). Set to "msg91" with all three keys below for staging/prod.
#
# FAIL CLOSED: in production (NODE_ENV=production or APP_ENV=production), if
# SMS_PROVIDER=noop OR any of MSG91_AUTH_KEY/MSG91_SENDER/MSG91_TEMPLATE_ID is
# absent, the application refuses to start (boot-time throw).
#
# How to get credentials (MSG91, India):
#   1. Create an account at https://msg91.com/ and complete KYC.
#   2. Register a DLT Principal Entity ID with your telecom operator's DLT portal
#      (Jio/Airtel/Vi/BSNL) — REQUIRED by TRAI for any commercial/transactional SMS
#      in India before you can send a single message.
#   3. Register your Sender ID (6 alphabetic chars, e.g. "STMLIQ") on the DLT portal
#      and link it in the MSG91 dashboard → MSG91_SENDER.
#   4. Register + get approval for your message templates (OTP + transactional) on
#      the DLT portal; each approved template has a DLT Template ID.
#      MSG91_TEMPLATE_ID is the DEFAULT/OTP template id; sendSms() callers may pass
#      a more specific per-message dltTemplateId (Rule C-3) which takes precedence.
#   5. MSG91_AUTH_KEY: MSG91 Dashboard → API → Auth Key. [SERVER-ONLY] — never log,
#      never expose to client, never include in NEXT_PUBLIC_*/VITE_*.
#
# [SERVER-ONLY] MSG91_AUTH_KEY — never expose to client.
#
# SMS_PROVIDER=noop
# MSG91_AUTH_KEY=
# MSG91_SENDER=
# MSG91_TEMPLATE_ID=

# --- Payments (Razorpay) — behind PaymentProvider; Phase 2 (docs/plans/phase-2.md task #4) ---
# RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET: get from the Razorpay dashboard (TEST mode keys
# start with rzp_test_). KEY_ID is public (sent to checkout). KEY_SECRET is private — never
# log, never send to the client, never commit.
# RAZORPAY_WEBHOOK_SECRET: set this in the Razorpay dashboard when creating your webhook
# (Settings > Webhooks > Add New Webhook > copy the "Webhook Secret"). When absent, the
# webhook endpoint FAILS CLOSED — all incoming webhooks are rejected until this is set.
# RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# RAZORPAY_KEY_SECRET=your_key_secret_here
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# --- Email (AWS SES / Resend) — behind MailProvider; lands in Phase 6 ---
# SES_REGION=
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# RESEND_API_KEY=

# ── Mail (Phase 6) — MailProvider (behind ResendMailProvider / NoopMailProvider) ──
#
# MAIL_PROVIDER selects the adapter at boot. Default: "noop" (no emails sent in dev/CI).
# Set to "resend" with RESEND_API_KEY + MAIL_FROM for staging/prod.
#
# FAIL CLOSED: in production (NODE_ENV=production or APP_ENV=production), if
# MAIL_PROVIDER=noop OR RESEND_API_KEY/MAIL_FROM is absent, the application refuses
# to start (boot-time throw). This prevents a misconfigured deployment from silently
# discarding all outbound emails.
#
# How to get credentials (Resend):
#   1. Create an account at https://resend.com/
#   2. Add and verify your sending domain: Resend Dashboard → Domains → Add Domain.
#      Add the DNS records (DKIM + SPF) to your DNS provider.
#   3. Create an API key: Resend Dashboard → API Keys → Create API Key.
#      Use "Sending access" (not Full access) for least privilege.
#   4. Set the From address to your verified domain, e.g. noreply@yourdomain.com
#   5. Set up a webhook: Resend Dashboard → Webhooks → Add Endpoint.
#      Subscribe to: email.delivered, email.bounced, email.complained, email.opened.
#      Copy the "Signing Secret" (starts with "whsec_") → MAIL_WEBHOOK_SECRET.
#
# [SERVER-ONLY] RESEND_API_KEY, MAIL_FROM, MAIL_WEBHOOK_SECRET — never expose to client.
#
# MAIL_PROVIDER=noop
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=StimuliiQ <noreply@yourdomain.com>
# MAIL_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── WhatsApp (Phase 6) — WhatsAppProvider (behind WhatsAppCloudProvider / NoopWhatsAppProvider) ──
#
# WHATSAPP_PROVIDER selects the adapter at boot. Default: "noop" (no messages sent in dev/CI).
# Set to "whatsapp_cloud" with required keys for staging/prod.
#
# FAIL CLOSED: in production (NODE_ENV=production or APP_ENV=production), if
# WHATSAPP_PROVIDER=noop OR any required key is absent, the application refuses
# to start (boot-time throw).
#
# How to get credentials (Meta WhatsApp Cloud API):
#   1. Create a Meta Developer account at https://developers.facebook.com/
#   2. Create a Meta App (Business type) and add the WhatsApp product.
#   3. In Meta Business Manager → WhatsApp → API Setup:
#      - WHATSAPP_PHONE_NUMBER_ID: the numeric Phone Number ID (e.g. "106540352242922")
#      - Generate a temporary access token for testing, or create a System User in
#        Meta Business Manager for a permanent token → WHATSAPP_ACCESS_TOKEN
#   4. WHATSAPP_APP_SECRET: developers.facebook.com → your app → App Settings → Basic
#      → copy the "App Secret". Used to verify inbound webhook signatures (HMAC-SHA256).
#   5. Set up the webhook in Meta App Dashboard → WhatsApp → Configuration → Webhooks:
#      - Callback URL: https://your-api.yourdomain.com/api/v1/campaigns/webhooks/whatsapp
#      - Verify token: choose any random string → WHATSAPP_VERIFY_TOKEN
#      - Subscribe to: messages (for delivery/read receipts)
#   6. India DLT: Register templates at https://www.jio.com/dlt or relevant operator DLT portal.
#      The DLT template IDs go in campaign_templates.dlt_template_id (not in env vars).
#
# [SERVER-ONLY] WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_ACCESS_TOKEN, WHATSAPP_APP_SECRET — never expose to client.
# WHATSAPP_VERIFY_TOKEN is not a secret per se but treat it as one.
#
# WHATSAPP_PROVIDER=noop
# WHATSAPP_PHONE_NUMBER_ID=106540352242922
# WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WHATSAPP_APP_SECRET=abcdef1234567890abcdef1234567890
# WHATSAPP_VERIFY_TOKEN=my-random-webhook-verify-token

# ── Notification signing secret (Phase 6) — unsubscribe HMAC tokens ──
#
# Used to sign unsubscribe link tokens (AC-21, AC-77):
#   HMAC(NOTIFICATION_SIGNING_SECRET, userId + channel + nonce)
# The raw user ID / email is NOT decodable from the URL without this secret.
# Optional in dev/CI (a well-known fallback is used with a warning).
# REQUIRED in production (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# [SERVER-ONLY] Never log, never return to client.
#
# NOTIFICATION_SIGNING_SECRET=replace-with-a-random-32-plus-char-secret-here

# --- Video (Cloudflare Stream / Mux) — behind VideoProvider; Phase 3 (docs/plans/phase-3.md task #4) ---
#
# VIDEO_PROVIDER selects the adapter at boot. Default: "noop" (fake signed URLs for dev + tests).
# Set to "cloudflare_stream" or "mux" with the corresponding keys for staging/prod.
#
# SECURITY NOTES:
#   - NEVER expose signing keys or webhook secrets to the client or logs.
#   - Signing keys (CLOUDFLARE_STREAM_SIGNING_KEY_PEM / MUX_SIGNING_KEY_PRIVATE) sign the HLS JWT;
#     the SIGNED URL is returned to the client, the key is NEVER returned.
#   - Webhook secrets: when absent, verifyWebhookSignature FAILS CLOSED (all webhooks rejected).
#   - The real adapters throw at call time (not at boot) when their keys are missing — fail-closed.
#   - With VIDEO_PROVIDER=noop the app boots and runs without any video credentials; all
#     minted HLS URLs are FAKE (suitable for local dev and CI tests only).
#
# VIDEO_PROVIDER=noop
#
# ── Cloudflare Stream (set VIDEO_PROVIDER=cloudflare_stream to activate) ──────────────────
# Get these from: Cloudflare Dashboard > Stream > Signing Keys + Webhooks.
# CLOUDFLARE_ACCOUNT_ID: your Cloudflare account ID (used as the CDN subdomain).
# CLOUDFLARE_STREAM_API_TOKEN: create in API Tokens with "Stream:Edit" permission.
# CLOUDFLARE_STREAM_SIGNING_KEY_ID: kid from the signing key created via Stream API/dashboard.
# CLOUDFLARE_STREAM_SIGNING_KEY_PEM: the PKCS#8 PEM private key (raw PEM, or base64-encoded
#   as returned by the Cloudflare API — the adapter auto-detects and decodes both forms).
# CLOUDFLARE_STREAM_WEBHOOK_SECRET: copied from Stream > Webhooks > your webhook's secret.
#
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
# CLOUDFLARE_STREAM_SIGNING_KEY_ID=
# CLOUDFLARE_STREAM_SIGNING_KEY_PEM=
# CLOUDFLARE_STREAM_WEBHOOK_SECRET=
#
# ── Mux (set VIDEO_PROVIDER=mux to activate) ─────────────────────────────────────────────
# Get these from: Mux Dashboard > Settings > API Access Tokens + URL Signing Keys + Webhooks.
# MUX_TOKEN_ID / MUX_TOKEN_SECRET: Mux API access token (Basic auth for Mux REST API).
# MUX_SIGNING_KEY_ID: key id from Mux > Settings > URL Signing Keys.
# MUX_SIGNING_KEY_PRIVATE: base64-encoded PKCS#8 private key from the same page.
#   (The adapter also accepts a raw PEM if it starts with "-----BEGIN".)
# MUX_WEBHOOK_SECRET: from Mux > Settings > Webhooks > your endpoint's signing secret.
#
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_SIGNING_KEY_ID=
# MUX_SIGNING_KEY_PRIVATE=
# MUX_WEBHOOK_SECRET=

# --- Object storage (S3 / R2) — behind StorageProvider (Phase 4, docs/plans/phase-4.md §3) ---
#
# STORAGE_PROVIDER selects the adapter at boot. Default: "noop" (fake presigned URLs for dev + tests).
# Set to "s3" (AWS S3) or "r2" (Cloudflare R2) with the keys below for staging/prod.
#
# SECURITY NOTES:
#   - NEVER expose bucket name, region, or credentials to the client or logs.
#   - Presigned URLs ARE returned to the client (they are the bearer credentials for the PUT/GET),
#     but they are short-lived (default 300 s) and must not be cached or logged.
#   - The adapter throws at call time (not boot) when credentials are missing — fail-closed.
#   - STORAGE_PROVIDER=noop: app boots and runs without any storage credentials; all presigned
#     URLs returned are FAKE (suitable for local dev and CI tests only).
#   - IAM policy (least privilege): allow s3:GetObject, s3:PutObject, s3:DeleteObject,
#     s3:HeadObject on arn:aws:s3:::<BUCKET>/submissions/*, /certificates/*, /invoices/*,
#     /resources/* — and nothing broader.
#
# STORAGE_PROVIDER=noop
#
# ── AWS S3 (set STORAGE_PROVIDER=s3 to activate) ─────────────────────────────────────────────
# STORAGE_BUCKET: the S3 bucket name (private, no public ACL).
# STORAGE_REGION: e.g. "ap-south-1" (Mumbai) for India deployments.
# STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY: IAM access key with least-privilege policy.
# STORAGE_ENDPOINT: leave empty for AWS S3 (the SDK derives the endpoint from region).
#
# STORAGE_BUCKET=
# STORAGE_REGION=ap-south-1
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=
#
# ── Cloudflare R2 (set STORAGE_PROVIDER=r2 to activate) ─────────────────────────────────────
# All keys are the same as above; set STORAGE_ENDPOINT to your R2 account endpoint.
# STORAGE_REGION=auto  (R2 ignores the region value; "auto" satisfies the SDK requirement)
# STORAGE_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com
#
# STORAGE_BUCKET=
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com

# --- Captcha / bot-protection (Cloudflare Turnstile) — behind CaptchaProvider (Phase 5, task #3) ---
#
# CAPTCHA_PROVIDER selects the adapter at boot. Default: "noop" (all tokens accepted — dev + CI).
# Set to "turnstile" with CAPTCHA_SECRET_KEY for staging/prod.
#
# FAIL CLOSED: in production (NODE_ENV=production or APP_ENV=production), if CAPTCHA_PROVIDER=noop
# or CAPTCHA_SECRET_KEY is absent, the factory binds FailClosedCaptchaProvider — every captcha-gated
# write (leads, bookings, register, coupon-validate, enroll funnel) returns HTTP 422 until the key
# is configured and the app is restarted. Noop keeps dev/CI green; Turnstile is fail-closed in prod.
#
# CAPTCHA_SITE_KEY   — PUBLIC — safe for the client bundle / NEXT_PUBLIC_* env.
#                      The browser widget uses this to render the Turnstile challenge iframe.
#                      Copy it from: Cloudflare Dashboard → Turnstile → <your site> → Site Key.
#                      Also set NEXT_PUBLIC_CAPTCHA_SITE_KEY in your Next.js env for the web app.
# CAPTCHA_SECRET_KEY — SERVER-ONLY — never log, never return to client, never put in NEXT_PUBLIC_*.
#                      Used by the backend (TurnstileCaptchaProvider) to verify client tokens by
#                      calling https://challenges.cloudflare.com/turnstile/v0/siteverify.
#                      Copy it from: Cloudflare Dashboard → Turnstile → <your site> → Secret Key.
#
# CAPTCHA_PROVIDER=noop
# CAPTCHA_SITE_KEY=0x4AAAAAAA___your_site_key_here
# CAPTCHA_SECRET_KEY=0x4AAAAAAA___your_secret_key_here

# --- NEXT_PUBLIC_TURNSTILE_SITE_KEY (apps/web only — Task #8, Phase 5) ---
#
# [PUBLIC-CLIENT] The Cloudflare Turnstile site key for the marketing website.
# This is the client-side key used to render the Turnstile widget in the browser.
# It is SAFE to expose to the client bundle (NEXT_PUBLIC_* prefix).
#
# It must match CAPTCHA_SITE_KEY if you are using Cloudflare Turnstile as the
# CaptchaProvider (CAPTCHA_PROVIDER=turnstile) on the backend.
#
# When unset (or empty), apps/web TurnstileWidget renders a noop placeholder and
# immediately fires onToken("noop"). The Noop CaptchaProvider (dev/CI) accepts
# any token. In production with CAPTCHA_PROVIDER=turnstile, set this to your
# Cloudflare Turnstile SITE KEY (from: Cloudflare Dashboard → Turnstile → site key).
#
# SECURITY: The CAPTCHA_SECRET_KEY (server-side verification key) is [SERVER-ONLY].
#           It is documented below in the Captcha section.
#           Do NOT set NEXT_PUBLIC_CAPTCHA_SECRET_KEY — that would expose the secret.
#
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA___your_turnstile_site_key_here

# --- Analytics (GA4 + GTM) — consent-gated, client-side only (Phase 5, task #3 / task #11) ---
#
# ANALYTICS_PROVIDER selects whether analytics are enabled. Default: "noop" (no scripts loaded).
# Set to "ga4" with ANALYTICS_MEASUREMENT_ID to enable Google Analytics 4.
#
# CONSENT INVARIANT: all analytics scripts MUST ONLY load AFTER the visitor explicitly accepts
# the DPDP consent banner in apps/web. The ConsentBanner.onAccept callback is the only place
# analytics scripts may initialise. NEVER load GA4/GTM before consent.
#
# Classification:
#   ANALYTICS_PROVIDER            — backend env, not client-exposed directly
#   ANALYTICS_MEASUREMENT_ID      — [SERVER-ONLY via backend] used by the backend AnalyticsProvider;
#                                   NOT a client secret. The CLIENT equivalent is below.
#   ANALYTICS_GTM_ID              — [SERVER-ONLY via backend] same pattern.
#   NEXT_PUBLIC_ANALYTICS_MEASUREMENT_ID — [PUBLIC-CLIENT] the same GA4 ID exposed to apps/web.
#   NEXT_PUBLIC_ANALYTICS_GTM_ID         — [PUBLIC-CLIENT] the same GTM ID exposed to apps/web.
#
# All NEXT_PUBLIC_ANALYTICS_* vars are PUBLIC — safe for the client bundle.
# GA4/GTM do NOT involve a server-side secret for tag loading. If a Measurement Protocol API
# secret is ever needed for server-side events, add it as a separate, non-public env var.
#
# ANALYTICS_PROVIDER=noop
# ANALYTICS_MEASUREMENT_ID=G-XXXXXXXXXX
# ANALYTICS_GTM_ID=GTM-XXXXXXX

# [PUBLIC-CLIENT] GA4 Measurement ID for apps/web (consent-gated analytics).
# Must match ANALYTICS_MEASUREMENT_ID above if using the same GA4 property.
# From: Google Analytics → Admin → Data Streams → Web stream → Measurement ID.
# NEXT_PUBLIC_ANALYTICS_MEASUREMENT_ID=G-XXXXXXXXXX

# [PUBLIC-CLIENT] GTM Container ID for apps/web (consent-gated analytics). Optional.
# From: Google Tag Manager → <workspace> → Container Settings → Container ID.
# NEXT_PUBLIC_ANALYTICS_GTM_ID=GTM-XXXXXXX

# --- Certificate signing (Phase 4, docs/plans/phase-4.md task #4) ---
#
# CERT_SIGNING_SECRET signs the `cert_uid` embedded in every issued certificate
# (HMAC-SHA256). Public verification (GET /verify/:certUid) RECOMPUTES the signature,
# so a fabricated certificate row or a guessed uid without a valid signature FAILS
# verification. The secret is server-only — never logged, never returned to a client.
#
#   - Local dev / CI: when unset AND NODE_ENV != production, the signer uses a
#     well-known LOCAL-ONLY dev secret and logs a warning (fine for tests; the uids
#     it produces are NOT trustworthy across environments).
#   - Staging / production: REQUIRED. When unset in production the signer fails closed
#     (throws). Generate a strong value (>= 32 chars):
#       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# CERT_SIGNING_SECRET=replace-with-a-random-32-plus-char-secret-in-staging-and-prod

# --- Live class (Zoom / Google Meet) — behind LiveClassProvider (Phase 9, task T15) ---
#
# LIVE_CLASS_PROVIDER selects the adapter at boot. Default: "noop" (fake meetings for
# dev + tests). Set to "zoom" or "google_meet" with the corresponding keys below.
#
# FAIL CLOSED: in production, LIVE_CLASS_PROVIDER=noop OR missing required keys for
# the selected adapter causes a boot-time throw.
#
# LIVE_CLASS_PROVIDER=noop
#
# ── Zoom (set LIVE_CLASS_PROVIDER=zoom to activate) — Server-to-Server OAuth app ──
# Create at: https://marketplace.zoom.us/ → Develop → Build App → Server-to-Server OAuth.
# Grant scopes: meeting:write:meeting, meeting:write:registrant, meeting:read:meeting,
# meeting:update:meeting. ZOOM_WEBHOOK_SECRET_TOKEN comes from the app's
# Feature > Event Subscriptions > Secret Token (subscribe to meeting.started,
# meeting.ended, meeting.participant_joined, meeting.participant_left, recording.completed).
#
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_WEBHOOK_SECRET_TOKEN=
#
# ── Google Meet (set LIVE_CLASS_PROVIDER=google_meet to activate) — Workspace service account ──
# 1. Google Cloud Console: create a project, enable the "Google Calendar API".
# 2. Create a Service Account + JSON key.
# 3. Google Workspace Admin Console → Security → API Controls → Domain-wide Delegation:
#    authorize the service account's Client ID for scope
#    https://www.googleapis.com/auth/calendar.events
# 4. GOOGLE_MEET_IMPERSONATE_USER_EMAIL must be a real Workspace mailbox the service
#    account impersonates (domain-wide delegation requires an actual calendar owner).
#
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_MEET_IMPERSONATE_USER_EMAIL=
# GOOGLE_MEET_CALENDAR_ID=primary

# --- Queue driver (BullMQ) — behind the async-work seams (Phase 9, task T18 / R1) ---
#
# QUEUE_DRIVER selects whether NotificationDispatchPort/CampaignSendPort/InvoiceGenPort/
# WebhookProcessorPort/VideoWebhookProcessorPort/CertificatePdfPort/ReportPdfPort run
# SYNCHRONOUSLY in-request (default "sync" — required for the Jest unit suite, which
# stays synchronous and Redis-free) or via BullMQ-backed queues processed by a separate
# worker process (`pnpm --filter @stimuliiq/api run worker`, apps/api/src/worker.ts).
#
# Uses the same REDIS_URL as sessions/cache (a dedicated ioredis connection with
# maxRetriesPerRequest:null, as BullMQ requires for its blocking commands).
#
# QUEUE_DRIVER=sync

# Extra browser origins allowed by CORS beyond WEB/LMS/CRM_APP_URL (comma-separated).
# The e2e suites serve the apps on their own ports (web: 3100), so browser-side API calls
# from those runs need their origin allowed. Leave UNSET in production.
EXTRA_CORS_ORIGINS=http://localhost:3100
