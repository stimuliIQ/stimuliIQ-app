# Normalize line endings: LF in the repository, native in the working tree.
# Without this, Windows checkouts commit CRLF and diffs churn across machines.
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary

# Lockfile: generated, collapse in diffs and reviews.
pnpm-lock.yaml -diff linguist-generated

# Prisma migrations are forward-only and never edited after shipping.
prisma/migrations/**/*.sql -diff
