# ==============================================================================
# StimuliiQ — PRODUCTION env template  (API host: Railway)
# ------------------------------------------------------------------------------
# Fill every value. These are the vars the API's fail-closed boot guards REQUIRE
# in production — a missing one makes the app refuse to start (by design).
# Full per-vendor setup steps: docs/deploy/production-go-live.md + .env.example
# NEVER commit the filled-in file. NEVER put a SERVER-ONLY var behind NEXT_PUBLIC_/VITE_.
# Generate 32-byte secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================

# --- App -----------------------------------------------------------------------
NODE_ENV=production
APP_ENV=production
API_PORT=4000
# www is CANONICAL — apex 307-redirects to www, so browsers call the API from the
# www origin. Setting the apex here CORS-blocks every public form on the live site.
WEB_APP_URL=https://www.stimuliiq.com
LMS_APP_URL=https://learn.stimuliiq.com
CRM_APP_URL=https://admin.stimuliiq.com
# EXTRA_CORS_ORIGINS must stay UNSET in production.

# --- Database (Supabase) -------------------------------------------------------
# RUNTIME = pooled (6543). MIGRATIONS (CI secret DATABASE_URL_STAGING_OR_PROD) = direct (5432).
DATABASE_URL=postgresql://postgres:<pw>@<host>:6543/postgres?sslmode=require&pgbouncer=true

# --- Redis (Upstash — managed, TLS) --------------------------------------------
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379
# Keep sync for launch — Upstash bills per-command and BullMQ's blocking polls burn the
# free tier. Switch to bullmq (and run the worker) only when you scale, watching usage.
QUEUE_DRIVER=sync

# --- JWT / cookies / CSRF ------------------------------------------------------
JWT_PRIVATE_KEY_PATH=/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/secrets/jwt-public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECRET=            # >=32 chars
CSRF_SECRET=              # >=32 chars, different from COOKIE_SECRET
COOKIE_DOMAIN=.stimuliiq.com
COOKIE_SECURE=true

# --- Signing secrets (all boot-throw in prod if unset) -------------------------
CERT_SIGNING_SECRET=          # >=32
TWO_FACTOR_ENC_KEY=           # >=32
NOTIFICATION_SIGNING_SECRET=  # >=32
METRICS_TOKEN=                # >=16

# --- Email (Resend) ------------------------------------------------------------
MAIL_PROVIDER=resend
RESEND_API_KEY=re_
MAIL_FROM=StimuliiQ <noreply@stimuliiq.com>
MAIL_WEBHOOK_SECRET=whsec_

# --- WhatsApp (Meta Cloud API — WABA 9177748321) -------------------------------
# 'disabled' = outbound WhatsApp OFF, boots with no Meta account. Set whatsapp_cloud + the
# keys below to enable. ('noop' boot-throws in prod — use 'disabled' to intentionally skip.)
WHATSAPP_PROVIDER=disabled
# WHATSAPP_PHONE_NUMBER_ID=      # numeric ID from Meta, NOT the phone number
# WHATSAPP_ACCESS_TOKEN=EAA      # permanent System User token
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# --- SMS / OTP (MSG91 — needs TRAI DLT) ----------------------------------------
# 'disabled' = SMS OFF, boots with no MSG91 account (ALSO disables phone-OTP login;
# email/password login still works). Set msg91 + keys to enable.
SMS_PROVIDER=disabled
# MSG91_AUTH_KEY=
# MSG91_SENDER=STMLIQ            # 6-char DLT-registered sender
# MSG91_TEMPLATE_ID=            # approved OTP DLT template id

# --- Payments (Razorpay LIVE) --------------------------------------------------
# 'disabled' = online checkout/enroll OFF (enrol students manually via the CRM), boots with
# no Razorpay account. Set razorpay + LIVE keys below to enable online payments.
PAYMENT_PROVIDER=disabled
# RAZORPAY_KEY_ID=rzp_live_      # boot-throws if rzp_test_ in prod
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=       # without this, EVERY webhook is rejected

# --- Object storage (Cloudflare R2) --------------------------------------------
#
# ⚠️ TWO BUCKETS, NOT ONE. This is a security requirement, not a preference, and the API
# now REFUSES TO BOOT in production if PUBLIC_ASSET_BASE_URL is set while
# STORAGE_PUBLIC_BUCKET is not.
#
#   STORAGE_BUCKET        — PRIVATE. Public access OFF. Holds student submissions,
#                           CSV/PDF exports (PII), invoices, receipts, certificates,
#                           lesson resources, career resumes and onboarding receipts.
#                           Reachable only through short-lived signed URLs.
#   STORAGE_PUBLIC_BUCKET — PUBLIC. Holds ONLY the image namespaces the marketing site
#                           serves over the CDN: program_images/, marketing_images/,
#                           mentor_photos/, college_logos/, program_brochures/.
#
# Why they cannot be the same bucket: a CDN can only read a bucket that allows anonymous
# reads, and R2 (like S3) grants public access PER BUCKET, never per prefix. Pointing
# PUBLIC_ASSET_BASE_URL at the private bucket therefore publishes everything in it —
# and several key shapes are deterministic (receipts/{tenantId}/{paymentId}.pdf,
# invoices/{tenantId}/{invoiceId}.pdf), with tenant ids readable straight out of any
# pay-link token. Nothing would be guessed; it would be enumerated.
STORAGE_PROVIDER=r2
STORAGE_BUCKET=
# [REQUIRED IN PROD whenever PUBLIC_ASSET_BASE_URL is set] The public image bucket.
STORAGE_PUBLIC_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# S3 API endpoint — used for UPLOADS (signed requests). NOT publicly readable, so it
# can never be used as the public read base below.
STORAGE_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com

# [REQUIRED IN PROD] Public READ base for uploaded assets — mentor photos, program
# images, blog covers, testimonial and partner logos. The API stores only the object
# KEY and mints `<PUBLIC_ASSET_BASE_URL>/<key>` at serve time (mintCdnUrl); a raw
# object URL is never returned to clients.
#
# ⚠️ This MUST point at STORAGE_PUBLIC_BUCKET, never at STORAGE_BUCKET — see the
# two-bucket note above. Setting it while STORAGE_PUBLIC_BUCKET is empty fails the boot.
#
# ⚠️ This is OPTIONAL in code and silently falls back to https://cdn.stimuliiq.com.
# If that hostname is not actually wired to the R2 bucket, every uploaded image
# 404s site-wide while the CRM still reports the upload as successful — there is no
# error anywhere to tell you. Set it explicitly. Two valid values:
#   1. The bucket's public r2.dev URL (R2 → bucket → Settings → Public access):
#        PUBLIC_ASSET_BASE_URL=https://pub-<hash>.r2.dev
#   2. A custom domain attached to the bucket in Cloudflare (DNS must be served by
#      Cloudflare, not pointed at Vercel):
#        PUBLIC_ASSET_BASE_URL=https://cdn.stimuliiq.com
# SET THIS IN BOTH PLACES. apps/web/next.config.mjs reads PUBLIC_ASSET_BASE_URL (or
# NEXT_PUBLIC_ASSET_BASE_URL) AT BUILD TIME and auto-adds that exact hostname to
# `images.remotePatterns` (**.stimuliiq.com and **.r2.cloudflarestorage.com are already
# allowed). So a pub-<hash>.r2.dev base works only if the var is also present in the
# Vercel build environment — set it on the API host AND in Vercel, or next/image will
# refuse the host even though the API is minting correct URLs.
PUBLIC_ASSET_BASE_URL=

