{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@repo/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next-perf/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
