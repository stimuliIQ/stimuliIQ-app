{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@stimuliiq/web",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "regions": ["bom1"],

  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },

  "env": {
    "NEXT_PUBLIC_API_URL": "@stimuliiq-web-api-url",
    "NEXT_PUBLIC_SITE_URL": "@stimuliiq-web-site-url",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "@stimuliiq-web-turnstile-site-key",
    "NEXT_PUBLIC_ANALYTICS_MEASUREMENT_ID": "@stimuliiq-web-ga4-id",
    "NEXT_PUBLIC_ANALYTICS_GTM_ID": "@stimuliiq-web-gtm-id",
    "NEXT_PUBLIC_WHATSAPP_NUMBER": "@stimuliiq-web-whatsapp-number",
    "NEXT_PUBLIC_WHATSAPP_MESSAGE": "@stimuliiq-web-whatsapp-message",
    "TOS_VERSION": "@stimuliiq-tos-version"
  },

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
