{
  "name": "@stimuliiq/api",
  "version": "0.0.0",
  "private": true,
  "description": "stimuliiq backend — NestJS modular monolith",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node --watch --env-file=../../.env --env-file-if-exists=../../.env.local -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "worker": "node --watch --env-file=../../.env --env-file-if-exists=../../.env.local -r ts-node/register -r tsconfig-paths/register src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../../.env dist/main.js",
    "start:worker": "node --env-file=../../.env dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:integration": "jest --config jest.integration.config.js --passWithNoTests --runInBand",
    "test:integration:safe": "node ./scripts/test-integration-safe.cjs",
    "e2e": "echo \"@stimuliiq/api: e2e (Playwright) deferred — see qa-engineer Wave 5 report (Phase 0 prioritizes unit+integration)\" && exit 0",
    "db:migrate": "prisma migrate dev --config ../../prisma.config.ts",
    "db:seed": "echo \"@stimuliiq/api: seed.ts lands with db-architect (Wave 2)\" && exit 0",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1078.0",
    "@aws-sdk/s3-request-presigner": "^3.1078.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^6.1.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@prisma/client": "^6.1.0",
    "@react-pdf/renderer": "^3.4.5",
    "@repo/types": "workspace:*",
    "@sentry/node": "^8.47.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.79.3",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "nestjs-pino": "^4.3.1",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "react": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.16.0",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@repo/config": "workspace:*",
    "@testcontainers/postgresql": "^12.0.3",
    "@testcontainers/redis": "^12.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.17",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^6.1.0",
    "rimraf": "^6.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.0.3",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
